# Local default; change if Ollama runs elsewhere.
OLLAMA_HOST=http://localhost:11434

# Needed only for anthropic:* models.
ANTHROPIC_API_KEY=

# Needed only for openai:* models. Set OPENAI_BASE_URL to use any OpenAI-compatible server.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Tracing is enabled only when both keys are set and the [langfuse] extra is installed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
